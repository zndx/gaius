+def _sanitize_ld_library_path(env):
+    """Remove Nix gcc libstdc++ from LD_LIBRARY_PATH in subprocess env.
+
+    devenv's Python wrapper injects gcc-XX.X.X-lib/lib into LD_LIBRARY_PATH.
+    This libstdc++ is built against Nix's glibc (2.42+), but host binaries
+    (dpkg-query, apt-get) only have the system glibc (e.g., 2.35 on Ubuntu
+    22.04), causing "GLIBC_2.38 not found" crashes.
+
+    Nix binaries don't need this path (they use RUNPATH), so removing it
+    is safe and prevents host binary crashes in conan system recipes.
+    """
+    if ld_path := env.get("LD_LIBRARY_PATH"):
+        paths = [
+            p for p in ld_path.split(":")
+            if not ("/nix/store" in p and "gcc" in p and "-lib/lib" in p)
+        ]
+        env["LD_LIBRARY_PATH"] = ":".join(paths) if paths else ""
+    return env
+
