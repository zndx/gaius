[Unit]
Description=Gaius workload watchdog (continuous; recycle the unit if the engine's intended serving set stays unmet)
Documentation=file:///home/rch/local/src/zndx/gaius/docs/scratch/2026-08-26/170000_crash-recovery-hardening.md
# Consumes the engine's Engine/WatchWorkload stream: verifies desired-vs-actual only
# while SETTLED (past each intent's warmup), holds during a changeover, and honors
# GPU eviction (an evicted capability drops out of the intent set). Engine death /
# :50051 dark is gaius-engine-ready's job, not this one.
After=gaius.service
# PartOf so an explicit stop/restart of gaius.service propagates here (operator stop
# is not fought; a recycle brings the watchdog back fresh). An engine/thinking crash
# does NOT change the oneshot gaius.service, so the watchdog keeps running.
PartOf=gaius.service
# Guard the WATCHDOG PROCESS itself from crash-looping; the recycle budget is
# separate and lives in the script's on-disk ledger.
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/home/rch/local/src/zndx/gaius/.devenv/state/venv/bin/python /home/rch/local/src/zndx/gaius/scripts/workload_watchdog.py
Restart=on-failure
RestartSec=30

[Install]
# Pulled up whenever gaius.service starts; stopped/restarted with it (PartOf).
WantedBy=gaius.service
