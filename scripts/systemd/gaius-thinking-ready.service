[Unit]
Description=Gaius thinking-ready watchdog (complete-recycle the unit if baseline GPU workload never admits)
Documentation=file:///home/rch/local/src/zndx/gaius/docs/scratch/2026-08-26/170000_crash-recovery-hardening.md
# Run after the engine is up and the foundation is ready; the boot preload has
# already had its first shot by the time we start polling.
After=gaius.service signals-ready.service
Wants=gaius.service
# Bounded: at most 3 complete-recycles per hour, then stop trying (a genuinely
# broken thinking should not recycle the unit forever).
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=oneshot
ExecStart=/home/rch/local/src/zndx/gaius/scripts/thinking-ready.sh
# The script polls up to GAIUS_THINKING_READY_DEADLINE_S (default 360s) before it
# recycles, so the start timeout must exceed that.
TimeoutStartSec=600
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
