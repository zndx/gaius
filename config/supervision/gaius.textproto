# (2026-09-04) The arbiter objective: declared intents are forecasts that the federation's
# arbiter applies them; this resolves them against Signals' records and the cluster ConfigMap.
objectives { name: "queue_share_arbitration" surfaced_result: "yunikorn-configs guaranteed GPU per leaf vs live declared intents (Signals ListQueueShareRequests)" cadence_cron: "38 1,7,13,19 * * *"
  gates { name: "records_settled" kind: GATE_KIND_PROBE_PASS tier: TIER_SILVER params { key: "probe" value: "no live record RECORDED/APPLYING past QUEUE_SHARE_APPLY_NET_S" } rationale: "an applier that never applies is the silent failure" }
  gates { name: "floors_applied" kind: GATE_KIND_PROBE_PASS tier: TIER_SILVER params { key: "probe" value: "configmap guaranteed[leaf] == max live APPLIED declared floor[leaf]" } rationale: "the arbiter merge is the contract (declared floor, else share guaranteed; max per leaf)" }
  gates { name: "intents_honoured" kind: GATE_KIND_PROBE_PASS tier: TIER_SILVER params { key: "probe" value: "every held phase intent has a live APPLIED record" } rationale: "a run whose phase intent was never applied ran unprotected" }
  expectation { category: EXPECTATION_CATEGORY_SLOT horizon_slot: 5 channel: CHANNEL_REMINDER rationale: "6 h verify cadence; a FAIL is a Reminder by 5 h unless the next verify resolves it" } }

# (2026-09-04) The Backlog itself carries an objective: every cadenced process has a
# slot-0 row filled within 2 h and a supervisor session is live. Later: "every open item
# surfaced on its channel before its horizon slot" (GATE_KIND_BACKLOG_SURFACED).
objectives { name: "ops_backlog" surfaced_result: "/backlog shows every cadenced workflow with a fresh slot-0 row; /nautilus status shows a live session" cadence_cron: "38 1,7,13,19 * * *"
  gates { name: "filled_within_horizon" kind: GATE_KIND_FRESHNESS_WITHIN tier: TIER_SILVER params { key: "sql" value: "SELECT max(filled_at) FROM nautilus_backlog WHERE slot = 0" } params { key: "within_seconds" value: "7200" } rationale: "the hourly tick has 2 h (F=2) to land a slot-0 row for every workflow" }
  gates { name: "nautilus_connected" kind: GATE_KIND_FRESHNESS_WITHIN tier: TIER_SILVER params { key: "sql" value: "SELECT max(last_heartbeat_at) FROM supervision_sessions" } params { key: "within_seconds" value: "7200" } rationale: "a Supervise session heartbeated within 2 h" }
  horizon { window_seconds: 7200 resolve_within_phase_only: false }
  expectation { category: EXPECTATION_CATEGORY_SLOT horizon_slot: 3 channel: CHANNEL_AGENDA_EVENT rationale: "verified four times daily; a FAIL on what the user receives is an Agenda Event within 2 h" } }
