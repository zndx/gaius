  gates { name: "footprint_advanced" kind: GATE_KIND_FOOTPRINT_ADVANCED tier: TIER_SILVER params { key: "sql" value: "SELECT count(*) FROM cognition_thoughts WHERE created_at > NOW() - INTERVAL '8 hours'" } params { key: "min" value: "1" } rationale: "skeleton: caught the 2026-09-02 THINKBURN drought (cycle green, zero thoughts)" }
