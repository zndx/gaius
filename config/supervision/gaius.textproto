  gates { name: "footprint_advanced" kind: GATE_KIND_FOOTPRINT_ADVANCED tier: TIER_SILVER params { key: "sql" value: "SELECT count(*) FROM cognition_buffer WHERE kind='synthesis' AND created_at > NOW() - INTERVAL '2 hours'" } params { key: "min" value: "1" } rationale: "skeleton: synthesis lands on schedule" }
