# proto-file: zndx/supervision/v1/supervision.proto
# proto-message: zndx.supervision.v1.Supervisor
#
# Gaius supervision instance — derived from the 2026-09-02 self-observation audit
# (docs/notes/2026-09-02/001900_ops_sweep_log.md, 23:10 entry). This is the only
# place "gaius", a flow name, or a rubric appears; the grammar lives in the shared
# protocol. Every restart strategy is NONE for the read-only adoption phase
# (nautilus_supervision.md §9): observe, stamp, score, escalate — never actuate —
# until the supervisor's own Brier record earns promotion per scope.

project: "gaius"
spec_version: "2026-09-05.1"
engine_build: "trunk"            # replaced by the deployed build id at launch; with
                                 # spec_version this is the scoring epoch
engine_grpc: "127.0.0.1:50051"
supervisor_grpc: "127.0.0.1:50061"   # the resident Nautilus (loopback beside the engine)
# Cadence.cron is project-local time; this host and pg_cron run in UTC.
attrs { key: "timezone" value: "UTC" }
# Nautilus directive mode for the adoption phase: observe (fill the Backlog, record
# firings and reclaim FORECASTS, send no directives) → reclaim,consult after promotion.
attrs { key: "directives" value: "observe" }

budgets {
  recycle_k: 3
  recycle_window_seconds: 3600
  recycle_cooldown_seconds: 240
  judge_consults_per_day: 6
  rubric_judgments_per_day: 8
}

# ── Host units (root of the tree) ──────────────────────────────────────────────

processes {
  id: "gaius.service"
  kind: PROCESS_KIND_SYSTEMD_UNIT
  restart: RESTART_STRATEGY_NONE          # promote to ONE_FOR_ALL after read-only phase
  observation { source: SOURCE_KIND_SYSTEMD locator: "gaius.service" poll_seconds: 15 }
  warmup_seconds: 330                     # engine + 27B load; matches declared thinking warmup
  attrs { key: "control_plane" value: "systemd oneshot -> just up (devenv process-compose)" }
}
processes {
  id: "engine"
  kind: PROCESS_KIND_EXTERNAL_SERVICE     # the zndx.engine.v1 face on :50051
  parent: "gaius.service"
  restart: RESTART_STRATEGY_NONE
  observation { source: SOURCE_KIND_ENGINE_GRPC locator: "127.0.0.1:50051" poll_seconds: 0 }
  warmup_seconds: 120
  reports_positions: true
}
processes {
  id: "devenv-postgres"
  kind: PROCESS_KIND_EXTERNAL_SERVICE
  parent: "gaius.service"
  restart: RESTART_STRATEGY_NONE
  observation { source: SOURCE_KIND_HTTP_PROBE locator: "tcp://127.0.0.1:5444" poll_seconds: 30 }
  attrs { key: "note" value: "supervisor bookkeeping target; write-ahead buffer covers its absence" }
}

# ── Serving endpoints (WatchWorkload intents) ──────────────────────────────────

processes {
  id: "endpoint.thinking"
  kind: PROCESS_KIND_SERVING_ENDPOINT
  parent: "engine"
  restart: RESTART_STRATEGY_NONE
  observation { source: SOURCE_KIND_ENGINE_GRPC locator: "thinking" }
  warmup_seconds: 330
  depends_on: "engine"
  attrs { key: "model" value: "Qwen/Qwen3.8-27B" }
  attrs { key: "gpus" value: "0-3" }
  # Standing occupancy: four of the host's six tokens, never preempted (heavy is
  # fenced). Everything else on the box contends for the remaining two.
  resources { leaf: "root.internal.inference.heavy" workload: "thinking" occupancy: 4 floor: 4 priority: 100
              rationale: "Qwen3.8-27B TP=4 is the thinking lane every workload consumes; cold reload is ~2.5 min" }
}
# The resident CLT worker (gaius-clt on GPU 4): a GPU consumer with NO floor — it
# is the preemption victim of choice when a flow needs the light token, and the
# 5-minute probe cadence re-admits it afterwards. Priority below every flow.
processes {
  id: "worker.clt"
  kind: PROCESS_KIND_SERVING_ENDPOINT
  parent: "engine"
  restart: RESTART_STRATEGY_NONE
  observation { source: SOURCE_KIND_ENGINE_GRPC locator: "gaius-clt" }
  warmup_seconds: 120
  depends_on: "engine"
  attrs { key: "model" value: "bluelightai/clt-qwen3-1.7b" }
  attrs { key: "gpus" value: "4" }
  resources { leaf: "root.internal.inference.light" workload: "clt-probe" occupancy: 1 floor: 0 priority: 10
              rationale: "a probe that runs every 5 min can wait; it must never hold a token a run needs" }
}

# ── In-engine daemons ──────────────────────────────────────────────────────────

processes { id: "daemon.scheduled_task_processor" kind: PROCESS_KIND_ENGINE_DAEMON parent: "engine" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_ENGINE_GRPC locator: "scheduled_task_processor" } depends_on: "devenv-postgres" }
processes { id: "daemon.health_observer" kind: PROCESS_KIND_ENGINE_DAEMON parent: "engine" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_ENGINE_GRPC locator: "health_observer" } }
processes { id: "daemon.cognition" kind: PROCESS_KIND_ENGINE_DAEMON parent: "engine" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_ENGINE_GRPC locator: "cognition" } depends_on: "endpoint.thinking" }
processes { id: "daemon.theta" kind: PROCESS_KIND_ENGINE_DAEMON parent: "engine" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_ENGINE_GRPC locator: "theta" } }
processes { id: "daemon.metaagent" kind: PROCESS_KIND_ENGINE_DAEMON parent: "engine" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_ENGINE_GRPC locator: "metaagent" } }
processes { id: "daemon.reconciliation" kind: PROCESS_KIND_ENGINE_DAEMON parent: "engine" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_ENGINE_GRPC locator: "reconciliation" } attrs { key: "note" value: "30s endpoint probe + 3-strike PROBEFLAP gate; the only site stamping momentum" } }
# daemon.nautilus (in-engine) is NOT declared: the supervisor never lives in its own tree.
# The in-engine NautilusService still runs during the observe phase beside the resident
# Rust Nautilus (supervisor_grpc) and retires at promotion (GAIUS_NAUTILUS_INENGINE=0).

# ── Scheduled task classes (claimed by the processor; enqueued by pg_cron) ─────
# cadence.cron mirrors the pg_cron job that enqueues the class; net_seconds is the
# generous outer net (progress-over-timeouts), NOT a kill deadline.

processes { id: "task.publish_cards" kind: PROCESS_KIND_SCHEDULED_TASK parent: "daemon.scheduled_task_processor" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_TASK_QUEUE locator: "publish_cards" } cadence { cron: "0 2,12,17,21 * * *" net_seconds: 14400 } depends_on: "endpoint.thinking" attrs { key: "singleton" value: "true" } expectation { category: EXPECTATION_CATEGORY_SLOT horizon_slot: 5 channel: CHANNEL_AGENDA_EVENT run_net_slot: 4 rationale: "slots at 02/12/17/21 UTC (longest gap 10 h → horizon slot 5); a run past 3 h (run_net_slot 4) is a slot at risk — 108 min was the longest healthy run" } }
processes { id: "task.article_curate" kind: PROCESS_KIND_SCHEDULED_TASK parent: "daemon.scheduled_task_processor" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_TASK_QUEUE locator: "article_curate" } cadence { cron: "7 9 * * *" net_seconds: 14400 } attrs { key: "singleton" value: "true" } expectation { category: EXPECTATION_CATEGORY_DAILY_DEPENDENT horizon_slot: 6 channel: CHANNEL_AGENDA_EVENT feeds: "task.publish_cards" rationale: "daily 09:07 curate feeds the publish slots; case B 2026-09-04: deferred 09:17 with no retry, surfaced 4 h later by content_currency — an item at the miss, horizon = the slot it feeds (round down)" } }
processes { id: "task.prospects_check" kind: PROCESS_KIND_SCHEDULED_TASK parent: "daemon.scheduled_task_processor" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_TASK_QUEUE locator: "prospects_check" } cadence { cron: "0 7 * * *" net_seconds: 2700 } attrs { key: "gate" value: "meta.should_run_prospects_check() >= 24h" } expectation { category: EXPECTATION_CATEGORY_DAILY_DEPENDENT horizon_slot: 7 channel: CHANNEL_AGENDA_EVENT feeds: "task.prospects_update" rationale: "daily 07:00 check decides the update; horizon = the next morning brief" } }
processes { id: "task.prospects_update" kind: PROCESS_KIND_SCHEDULED_TASK parent: "daemon.scheduled_task_processor" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_TASK_QUEUE locator: "prospects_update" } cadence { expected_period_seconds: 86400 net_seconds: 14400 } depends_on: "endpoint.thinking" attrs { key: "enqueued_by" value: "task.prospects_check when filings warrant" } expectation { category: EXPECTATION_CATEGORY_DAILY_DEPENDENT horizon_slot: 7 channel: CHANNEL_AGENDA_EVENT feeds: "task.prospects_check" rationale: "daily update the briefs depend on; its judged verdict is prospects_intelligence" } }
processes { id: "task.objective_verify" kind: PROCESS_KIND_SCHEDULED_TASK parent: "daemon.scheduled_task_processor" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_TASK_QUEUE locator: "objective_verify" } cadence { cron: "38 1,7,13,19 * * *" net_seconds: 14400 } attrs { key: "completed_when_error_prefix" value: "#OBJ.00000002.OBJFAIL" } attrs { key: "note" value: "a FAILED row with the OBJFAIL prefix is a completed verifier run: the failed OBJECTIVE is its own JUDGED Backlog item (objective.<name>), never a miss of the verifier" } expectation { category: EXPECTATION_CATEGORY_SLOT horizon_slot: 5 channel: CHANNEL_AGENDA_EVENT run_net_slot: 5 rationale: "6 h cron; judged verifications legitimately run past an hour (net 4 h)" } }
processes { id: "task.tier_settle" kind: PROCESS_KIND_SCHEDULED_TASK parent: "daemon.scheduled_task_processor" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_TASK_QUEUE locator: "tier_settle" } cadence { cron: "20 * * * *" net_seconds: 2700 } attrs { key: "singleton" value: "true" } expectation { category: EXPECTATION_CATEGORY_HOURLY_SETTLED horizon_slot: 3 channel: CHANNEL_AGENDA_EVENT backfill_depth: 2 rationale: "hourly settle with --backfill 2: a missed tick is absorbed by the next run's backfill; unverified past two hours is the miss (case C: the 15:20 tick lost to a restart, 496814 settled at 16:20)" } }
processes { id: "task.clt_skos_admit" kind: PROCESS_KIND_SCHEDULED_TASK parent: "daemon.scheduled_task_processor" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_TASK_QUEUE locator: "clt_skos_admit" } cadence { cron: "*/15 * * * *" net_seconds: 2700 } expectation { category: EXPECTATION_CATEGORY_TICK horizon_slot: 3 channel: CHANNEL_AGENDA_EVENT rationale: "case A 2026-09-04: 28 deferrals silent for ~6 h under a 6 h objective; an Agenda Event at slot 3 (2 h) beats the human by four hours" } }
processes { id: "task.clt_skos_label" kind: PROCESS_KIND_SCHEDULED_TASK parent: "daemon.scheduled_task_processor" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_TASK_QUEUE locator: "clt_skos_label" } cadence { cron: "*/15 * * * *" net_seconds: 2700 } expectation { category: EXPECTATION_CATEGORY_TICK horizon_slot: 3 channel: CHANNEL_AGENDA_EVENT rationale: "sub-hour cadence: a deferral inside the admission window is the arbiter working; no completed run at slots 1 and 2 opens the item; Agenda Event at slot 3 (2 h)" } }
processes { id: "task.feature_probe" kind: PROCESS_KIND_SCHEDULED_TASK parent: "daemon.scheduled_task_processor" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_TASK_QUEUE locator: "feature_probe" } cadence { cron: "*/5 * * * *" net_seconds: 2700 } expectation { category: EXPECTATION_CATEGORY_TRANSIENT horizon_slot: 1 channel: CHANNEL_LOG rationale: "5-min probe: one failure is ledger-only; open only if still failing at slot 1" } }
processes { id: "task.board_reindex" kind: PROCESS_KIND_SCHEDULED_TASK parent: "daemon.scheduled_task_processor" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_TASK_QUEUE locator: "board_reindex" } cadence { cron: "* * * * *" net_seconds: 2700 } expectation { category: EXPECTATION_CATEGORY_TICK horizon_slot: 3 channel: CHANNEL_AGENDA_EVENT rationale: "sub-hour cadence: a deferral inside the admission window is the arbiter working; no completed run at slots 1 and 2 opens the item; Agenda Event at slot 3 (2 h)" } }
processes { id: "task.heuristic_triage" kind: PROCESS_KIND_SCHEDULED_TASK parent: "daemon.scheduled_task_processor" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_TASK_QUEUE locator: "heuristic_triage" } cadence { cron: "5 * * * *" net_seconds: 2700 } expectation { category: EXPECTATION_CATEGORY_TICK horizon_slot: 3 channel: CHANNEL_AGENDA_EVENT rationale: "sub-hour cadence: a deferral inside the admission window is the arbiter working; no completed run at slots 1 and 2 opens the item; Agenda Event at slot 3 (2 h)" } }
processes { id: "task.engine_audit" kind: PROCESS_KIND_SCHEDULED_TASK parent: "daemon.scheduled_task_processor" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_TASK_QUEUE locator: "engine_audit" } cadence { cron: "30 * * * *" net_seconds: 2700 } expectation { category: EXPECTATION_CATEGORY_TICK horizon_slot: 3 channel: CHANNEL_AGENDA_EVENT rationale: "sub-hour cadence: a deferral inside the admission window is the arbiter working; no completed run at slots 1 and 2 opens the item; Agenda Event at slot 3 (2 h)" } }
processes { id: "task.content_processing" kind: PROCESS_KIND_SCHEDULED_TASK parent: "daemon.scheduled_task_processor" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_TASK_QUEUE locator: "content_processing" } cadence { cron: "45 */2 * * *" net_seconds: 2700 } expectation { category: EXPECTATION_CATEGORY_SLOT horizon_slot: 5 channel: CHANNEL_AGENDA_EVENT run_net_slot: 4 rationale: "2 h cadence" } }
processes { id: "task.cognition_cycle" kind: PROCESS_KIND_SCHEDULED_TASK parent: "daemon.scheduled_task_processor" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_TASK_QUEUE locator: "cognition_cycle" } cadence { cron: "43 0,4,8,12,16,20 * * *" net_seconds: 2700 } depends_on: "endpoint.thinking" expectation { category: EXPECTATION_CATEGORY_SLOT horizon_slot: 5 channel: CHANNEL_AGENDA_EVENT run_net_slot: 4 rationale: "4 h anchor; a missed cycle surfaces by the next Fibonacci hour above the gap" } }
processes { id: "task.llm_triage" kind: PROCESS_KIND_SCHEDULED_TASK parent: "daemon.scheduled_task_processor" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_TASK_QUEUE locator: "llm_triage" } cadence { cron: "35 0,4,8,12,16,20 * * *" net_seconds: 2700 } depends_on: "endpoint.thinking" expectation { category: EXPECTATION_CATEGORY_SLOT horizon_slot: 5 channel: CHANNEL_AGENDA_EVENT run_net_slot: 4 rationale: "4 h cadence; p95 17 min" } }
processes { id: "task.feed_check" kind: PROCESS_KIND_SCHEDULED_TASK parent: "daemon.scheduled_task_processor" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_TASK_QUEUE locator: "feed_check" } cadence { cron: "17 */4 * * *" net_seconds: 2700 } expectation { category: EXPECTATION_CATEGORY_SLOT horizon_slot: 5 channel: CHANNEL_AGENDA_EVENT run_net_slot: 4 rationale: "4 h cadence" } }
processes { id: "task.evolution_cycle" kind: PROCESS_KIND_SCHEDULED_TASK parent: "daemon.scheduled_task_processor" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_TASK_QUEUE locator: "evolution_cycle" } cadence { expected_period_seconds: 43200 net_seconds: 2700 } expectation { category: EXPECTATION_CATEGORY_SLOT horizon_slot: 6 channel: CHANNEL_BRIEFING run_net_slot: 4 rationale: "12 h expected period; daemon not running is a known config gap — briefing material, not an alarm" } }
processes { id: "task.content_diversity_check" kind: PROCESS_KIND_SCHEDULED_TASK parent: "daemon.scheduled_task_processor" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_TASK_QUEUE locator: "content_diversity_check" } cadence { cron: "0 6,18 * * *" net_seconds: 2700 } expectation { category: EXPECTATION_CATEGORY_SLOT horizon_slot: 6 channel: CHANNEL_BRIEFING run_net_slot: 4 rationale: "12 h cadence (06/18 UTC): a miss is briefing material" } }

# ── pg_cron jobs that act directly (not via the task queue) ────────────────────

processes { id: "cron.task-watchdog" kind: PROCESS_KIND_PG_CRON_JOB parent: "devenv-postgres" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_PG_CRON locator: "task-watchdog" } cadence { cron: "10,25,40,55 * * * *" net_seconds: 900 } attrs { key: "note" value: "resets stale claims: 45m default, 4h for publish/curate/prospects; forecast captured in-statement" } expectation { category: EXPECTATION_CATEGORY_TICK horizon_slot: 3 channel: CHANNEL_AGENDA_EVENT rationale: "sub-hour cadence: a deferral inside the admission window is the arbiter working; no completed run at slots 1 and 2 opens the item; Agenda Event at slot 3 (2 h)" } }
processes { id: "cron.tier-settle-signal" kind: PROCESS_KIND_PG_CRON_JOB parent: "devenv-postgres" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_PG_CRON locator: "tier-settle-signal" } cadence { cron: "20 * * * *" net_seconds: 900 } expectation { category: EXPECTATION_CATEGORY_TICK horizon_slot: 3 channel: CHANNEL_AGENDA_EVENT rationale: "sub-hour cadence: a deferral inside the admission window is the arbiter working; no completed run at slots 1 and 2 opens the item; Agenda Event at slot 3 (2 h)" } }
processes { id: "cron.objective-verify" kind: PROCESS_KIND_PG_CRON_JOB parent: "devenv-postgres" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_PG_CRON locator: "objective-verify" } cadence { cron: "38 1,7,13,19 * * *" net_seconds: 900 } expectation { category: EXPECTATION_CATEGORY_SLOT horizon_slot: 5 channel: CHANNEL_AGENDA_EVENT rationale: "the 6 h verify enqueuer" } }

# ── Peer engines (observe-through-engines: remote stores are read via a face) ──

processes { id: "peer.signals-engine" kind: PROCESS_KIND_EXTERNAL_SERVICE restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_ENGINE_GRPC locator: "127.0.0.1:50551" poll_seconds: 0 } attrs { key: "note" value: "Signals hosts the federation Metaflow service and central Airflow; their stores are read through this face, never by port" } }

# ── Metaflow flows (observed in the Signals Metaflow store, via the peer face) ─

processes { id: "flow.ProspectsUpdateFlow" kind: PROCESS_KIND_METAFLOW_FLOW parent: "task.prospects_update" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_METAFLOW_STORE locator: "ProspectsUpdateFlow" poll_seconds: 60 via: "peer.signals-engine" } reports_positions: true cadence { expected_period_seconds: 86400 net_seconds: 14400 } expectation { category: EXPECTATION_CATEGORY_DAILY_DEPENDENT horizon_slot: 7 channel: CHANNEL_AGENDA_EVENT feeds: "task.prospects_check" rationale: "daily update the briefs depend on; its judged verdict is prospects_intelligence" } }
processes { id: "flow.ArticleCurationFlow" kind: PROCESS_KIND_METAFLOW_FLOW parent: "task.article_curate" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_METAFLOW_STORE locator: "ArticleCurationFlow" poll_seconds: 60 via: "peer.signals-engine" } reports_positions: true cadence { cron: "7 9 * * *" net_seconds: 14400 } expectation { category: EXPECTATION_CATEGORY_DAILY_DEPENDENT horizon_slot: 6 channel: CHANNEL_AGENDA_EVENT feeds: "task.publish_cards" rationale: "daily 09:07 curate feeds the publish slots; case B 2026-09-04: deferred 09:17 with no retry, surfaced 4 h later by content_currency — an item at the miss, horizon = the slot it feeds (round down)" } }
processes { id: "flow.CltSkosAdmitFlow" kind: PROCESS_KIND_METAFLOW_FLOW parent: "task.clt_skos_admit" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_METAFLOW_STORE locator: "CltSkosAdmitFlow" poll_seconds: 60 via: "peer.signals-engine" } cadence { cron: "*/15 * * * *" net_seconds: 2700 } expectation { category: EXPECTATION_CATEGORY_TICK horizon_slot: 3 channel: CHANNEL_AGENDA_EVENT rationale: "case A 2026-09-04: 28 deferrals silent for ~6 h under a 6 h objective; an Agenda Event at slot 3 (2 h) beats the human by four hours" } }
processes { id: "flow.CltSkosLabelFlow" kind: PROCESS_KIND_METAFLOW_FLOW parent: "task.clt_skos_label" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_METAFLOW_STORE locator: "CltSkosLabelFlow" poll_seconds: 60 via: "peer.signals-engine" } cadence { cron: "*/15 * * * *" net_seconds: 2700 } expectation { category: EXPECTATION_CATEGORY_TICK horizon_slot: 3 channel: CHANNEL_AGENDA_EVENT rationale: "sub-hour cadence: a deferral inside the admission window is the arbiter working; no completed run at slots 1 and 2 opens the item; Agenda Event at slot 3 (2 h)" } }
# ── (2026-09-04) The engine's private model timers, now flows on pg_cron ──────
processes { id: "task.fmp_roll" kind: PROCESS_KIND_SCHEDULED_TASK parent: "daemon.scheduled_task_processor" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_TASK_QUEUE locator: "fmp_roll" } cadence { cron: "7,37 * * * *" net_seconds: 1800 } expectation { category: EXPECTATION_CATEGORY_TICK horizon_slot: 3 channel: CHANNEL_AGENDA_EVENT rationale: "sub-hour cadence: a deferral inside the admission window is the arbiter working; no completed run at slots 1 and 2 opens the item; Agenda Event at slot 3 (2 h)" } }
processes { id: "flow.FmpMarketBufferFlow" kind: PROCESS_KIND_METAFLOW_FLOW parent: "task.fmp_roll" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_METAFLOW_STORE locator: "FmpMarketBufferFlow" poll_seconds: 60 via: "peer.signals-engine" } reports_positions: true cadence { cron: "7,37 * * * *" net_seconds: 1800 } expectation { category: EXPECTATION_CATEGORY_TICK horizon_slot: 3 channel: CHANNEL_AGENDA_EVENT rationale: "sub-hour cadence: a deferral inside the admission window is the arbiter working; no completed run at slots 1 and 2 opens the item; Agenda Event at slot 3 (2 h)" } }
processes { id: "task.ambient_synthesis" kind: PROCESS_KIND_SCHEDULED_TASK parent: "daemon.scheduled_task_processor" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_TASK_QUEUE locator: "ambient_synthesis" } cadence { cron: "*/20 * * * *" net_seconds: 3600 } expectation { category: EXPECTATION_CATEGORY_TICK horizon_slot: 3 channel: CHANNEL_AGENDA_EVENT rationale: "sub-hour cadence: a deferral inside the admission window is the arbiter working; no completed run at slots 1 and 2 opens the item; Agenda Event at slot 3 (2 h)" } }
processes { id: "flow.AmbientSynthesisFlow" kind: PROCESS_KIND_METAFLOW_FLOW parent: "task.ambient_synthesis" restart: RESTART_STRATEGY_NONE observation { source: SOURCE_KIND_METAFLOW_STORE locator: "AmbientSynthesisFlow" poll_seconds: 60 via: "peer.signals-engine" } reports_positions: true cadence { cron: "*/20 * * * *" net_seconds: 3600 } expectation { category: EXPECTATION_CATEGORY_TICK horizon_slot: 3 channel: CHANNEL_AGENDA_EVENT rationale: "sub-hour cadence: a deferral inside the admission window is the arbiter working; no completed run at slots 1 and 2 opens the item; Agenda Event at slot 3 (2 h)" } }

# ── Machines: phases, gates, horizons ──────────────────────────────────────────
# The motivating case: ProspectsUpdateFlow. Four phases, each closed by a gate that
# resolves only the forecasts made inside it. "The flow reached end" is a phase-4
# claim; the OBJECTIVE resolves that claim against the surfaced briefs.

machines {
  id: "prospects_update"
  process: "flow.ProspectsUpdateFlow"
  surfaced_result: "prospect briefs under kb/scratch/<day>/*prospect_*.md and current/prospects/<sym>/synthesis.md"
  default_horizon { window_seconds: 14400 resolve_within_phase_only: true }
  phases {
    id: "acquire" order: 1
    steps: "start" steps: "fetch_comprehensive_data" steps: "sync_filings" steps: "extract_filings"
    gate { name: "filings_synced" kind: GATE_KIND_FLOW_REACHED_STEP tier: TIER_SILVER
           params { key: "step" value: "extract_filings" }
           rationale: "FMP fetch + EDGAR sync + docling extraction landed for the watchlist" }
    horizon { window_seconds: 3600 resolve_within_phase_only: true }
    # The run's own extract token, protected for the run's duration (the Signals
    # publish contract stamps prospects runs on the extract leaf).
    resources { leaf: "root.internal.inference.extract" workload: "prospects-update" occupancy: 1 floor: 1 priority: 50
                rationale: "daily FMP chain; its token is the run's identity on the extract leaf" }
  }
  phases {
    id: "analyze" order: 2
    steps: "analyze_filings"
    gate { name: "analyses_persisted" kind: GATE_KIND_FOOTPRINT_ADVANCED tier: TIER_SILVER
           params { key: "source" value: "edgar_filings analyzed_at within run" } params { key: "min" value: "1" }
           rationale: "per-filing analyses written back to the edgar_filings product; the 2026-09-02 rebuild persisted ~116" }
    horizon { window_seconds: 14400 resolve_within_phase_only: true }
    resources { leaf: "root.internal.inference.extract" workload: "prospects-update" occupancy: 1 floor: 1 priority: 50 }
    # Analysis embeds filings through the shared ColBERT claim: PROTECT it for this
    # phase, above the CLT probe (priority 10) — the run is what needs the GPU.
    resources { leaf: "root.internal.inference.light" workload: "embedding" occupancy: 1 floor: 1 priority: 60
                rationale: "the 02:48 starvation: the run waited 600 s on embedding while a probe held light" }
  }
  phases {
    id: "synthesize" order: 3
    steps: "synthesize_position"
    gate { name: "positions_synthesized" kind: GATE_KIND_FLOW_REACHED_STEP tier: TIER_SILVER
           params { key: "step" value: "create_kb_artifacts" }
           rationale: "a synthesis across 20 analyses reasons past 10 min on thinking — 1800s Complete net" }
    horizon { window_seconds: 7200 resolve_within_phase_only: true }
    # Synthesis is thinking-lane work (the standing heavy claim); the run keeps
    # its extract identity but no longer needs the embedding claim.
    resources { leaf: "root.internal.inference.extract" workload: "prospects-update" occupancy: 1 floor: 1 priority: 50 }
  }
  phases {
    id: "surface" order: 4
    steps: "create_kb_artifacts" steps: "generate_base_files" steps: "create_sitrep" steps: "end"
    gate { name: "briefs_wellformed" kind: GATE_KIND_SURFACE_WELLFORMED tier: TIER_SILVER
           params { key: "glob" value: "scratch/*/*prospect_*.md" } params { key: "section" value: "## Summary" }
           params { key: "min_chars" value: "40" } params { key: "max_symbol_repeats" value: "2" }
           rationale: "empty Summary and (SYM)x23 title echoes were the 8-month hollow-brief signature" }
    horizon { window_seconds: 14400 resolve_within_phase_only: false }   # the objective closes this phase's claim
    # Surfacing writes files and renders .base; the token is held (the pod is the
    # run's identity) but fully preemptible — nothing here needs a GPU.
    resources { leaf: "root.internal.inference.extract" workload: "prospects-update" occupancy: 1 floor: 0 priority: 30 }
  }
}

machines {
  id: "article_curation"
  process: "flow.ArticleCurationFlow"
  surfaced_result: "published cards on gaius.zndx.org"
  default_horizon { window_seconds: 43200 resolve_within_phase_only: true }
  # (2026-09-04) Resource intents: the daily curate is the site_freshness /
  # content_currency DAG — the product's own pipeline — and had none: on
  # 2026-09-04 it deferred behind a forced prospects run at 09:17 (no
  # priority, no floor) and the 12:00 slot published stale-dated cards. The
  # run's identity is its extract token (kind article-curate); acquire is
  # where docling needs the GPU, so the floor is protected there at priority
  # 55 — above ambient's embedding (40) and the admit flow (20), on par with
  # a prospects run (50/60): a daily product run yields to nothing lighter.
  phases { id: "select" order: 1 steps: "grok_research_summary" steps: "select_article"
           gate { name: "article_selected" kind: GATE_KIND_FLOW_REACHED_STEP tier: TIER_SILVER params { key: "step" value: "acquire_external" } rationale: "an article with keywords/news_queries was chosen" }
           resources { leaf: "root.internal.inference.extract" workload: "article-curate" occupancy: 1 floor: 0 priority: 35
                       rationale: "selection is thinking-lane work; the run holds its token but needs no GPU yet" } }
  phases { id: "acquire" order: 2 steps: "acquire_external" steps: "join_fetchers" steps: "update_manifest"
           gate { name: "sources_acquired" kind: GATE_KIND_FLOW_REACHED_STEP tier: TIER_SILVER params { key: "step" value: "sync_grok_collection" } rationale: "external fetchers joined; manifest updated" }
           resources { leaf: "root.internal.inference.extract" workload: "article-curate" occupancy: 1 floor: 1 priority: 55
                       rationale: "docling extraction on the run's extract token; the 09:17 deferral behind prospects is what this floor prevents" } }
  phases { id: "draft" order: 3 steps: "sync_grok_collection" steps: "create_draft" steps: "create_base"
           gate { name: "draft_written" kind: GATE_KIND_FLOW_REACHED_STEP tier: TIER_SILVER params { key: "step" value: "create_cards" } rationale: "draft + .base exist" }
           resources { leaf: "root.internal.inference.extract" workload: "article-curate" occupancy: 1 floor: 0 priority: 35
                       rationale: "drafting is thinking-lane work; token held, fully preemptible" } }
  phases { id: "publish" order: 4 steps: "create_cards" steps: "enrich_cards" steps: "publish_batch" steps: "end"
           gate { name: "cards_public" kind: GATE_KIND_PROBE_PASS tier: TIER_SILVER params { key: "probe" value: "probe:publish.cards_public" } rationale: "cards synced to KV and served on the live page" }
           horizon { window_seconds: 43200 resolve_within_phase_only: false }
           resources { leaf: "root.internal.inference.extract" workload: "article-curate" occupancy: 1 floor: 0 priority: 30
                       rationale: "publishing writes files and KV; nothing here needs a GPU" } }
}
# The 15-minute CLT/SKOS admit: a light claim of its own (admit.py gpu_tokens=1)
# that backs the ColBERT-Zero MaxSim the flow runs in-process (sentinel_claim.
# own_gpu_application — no shared gaius-embedding claim from a token holder),
# plus the CLT worker's token for positional extraction. Two tokens = the light
# leaf. Fully preemptible and low priority — a 15-minute cadence can always
# wait for the next tick — but above the CLT probe, so an admit that has
# started finishes before the probe reclaims GPU 4.
machines {
  id: "clt_skos_admit"
  process: "flow.CltSkosAdmitFlow"
  surfaced_result: "admitted inbound docs and their CLT activations in the feature tape"
  default_horizon { window_seconds: 1800 resolve_within_phase_only: true }
  phases {
    id: "start" order: 1
    steps: "start"
    gate { name: "claim_admitted" kind: GATE_KIND_FLOW_REACHED_STEP tier: TIER_SILVER
           params { key: "step" value: "admit" }
           rationale: "the flow's own YK claim placed (its guard refuses a class that disagrees with the map)" }
    horizon { window_seconds: 900 resolve_within_phase_only: true }
    resources { leaf: "root.internal.inference.light" workload: "clt-skos-admit" occupancy: 1 floor: 0 priority: 20
                rationale: "15-min cadence: a deferral costs one tick, never a failure row" }
  }
  phases {
    id: "admit" order: 2
    steps: "admit" steps: "end"
    gate { name: "docs_admitted" kind: GATE_KIND_FLOW_REACHED_STEP tier: TIER_SILVER
           params { key: "step" value: "end" }
           rationale: "batch admitted; extraction of new windows lands in the tape" }
    horizon { window_seconds: 1800 resolve_within_phase_only: true }
    resources { leaf: "root.internal.inference.light" workload: "clt-skos-admit" occupancy: 1 floor: 0 priority: 20
                rationale: "the flow's own token backs its in-process ColBERT-Zero MaxSim — it makes no shared embedding claim (2026-09-04: declaring embedding here too was a third token on a two-token leaf; 28 consecutive deferrals)" }
    resources { leaf: "root.internal.inference.light" workload: "clt-probe" occupancy: 1 floor: 0 priority: 20
                rationale: "positional CLT extraction runs on the CLT worker's token (gaius-clt): reused when resident, placed at the run's priority when not — the admit phase's true demand is exactly the light leaf" }
  }
}

# (2026-09-04) FMP roll: was ProspectsService's 60 s in-engine loop. Rate-metered
# external pull, compaction through Engine/Complete on thinking's standing claim.
# No GPU intent of its own — the only resource it contends for is the thinking
# lane, which is fenced heavy capacity.
machines {
  id: "fmp_roll"
  process: "flow.FmpMarketBufferFlow"
  surfaced_result: "live prospects rows in buffer_entries newer than the cadence, compacted under the FIFO budget"
  default_horizon { window_seconds: 1800 resolve_within_phase_only: true }
  phases {
    id: "ingest" order: 1
    steps: "start" steps: "ingest"
    gate { name: "market_rows_appended" kind: GATE_KIND_FOOTPRINT_ADVANCED tier: TIER_SILVER
           params { key: "sql" value: "SELECT count(*) FROM buffer_entries WHERE buffer='prospects' AND writer='flow:FmpMarketBufferFlow' AND created_at > NOW() - INTERVAL '1 hour'" }
           params { key: "min" value: "1" }
           rationale: "seven FMP streams; zero new rows across all of them is the FMPEMPTY failure, not a quiet market" }
    horizon { window_seconds: 900 resolve_within_phase_only: true }
  }
  phases {
    id: "compact" order: 2
    steps: "compact" steps: "end"
    gate { name: "fifo_under_budget" kind: GATE_KIND_FLOW_REACHED_STEP tier: TIER_SILVER
           params { key: "step" value: "end" }
           rationale: "compaction ran (or was under budget) — thinking down is an error here, never a skip" }
    horizon { window_seconds: 1800 resolve_within_phase_only: true }
  }
}

# (2026-09-04) Ambient synthesis: was AmbientWorkloadService's continuous in-engine
# cycle (HN fetch, compaction, cognition synthesis, plus a synthetic reasoning
# workload that evicted endpoints — dropped: that GPU juggling is what the
# declared intents replace). Synthesis admits Aperture windows by ColBERT
# MaxSim, so the synthesize phase carries the SHARED embedding claim above the
# CLT probe (10) and the admit flow (20), below a prospects run (60).
machines {
  id: "ambient_synthesis"
  process: "flow.AmbientSynthesisFlow"
  surfaced_result: "a thinking synthesis episode in cognition_buffer with its agenda notes in the KB"
  default_horizon { window_seconds: 3600 resolve_within_phase_only: true }
  phases {
    id: "fetch" order: 1
    steps: "start" steps: "fetch"
    gate { name: "buffers_refreshed" kind: GATE_KIND_FLOW_REACHED_STEP tier: TIER_SILVER
           params { key: "step" value: "compact" }
           rationale: "HN and publishing rows appended (dedupe by content); a dark HN is an error, an unchanged publishing set is not" }
    horizon { window_seconds: 600 resolve_within_phase_only: true }
  }
  phases {
    id: "compact" order: 2
    steps: "compact"
    gate { name: "fifos_under_budget" kind: GATE_KIND_FLOW_REACHED_STEP tier: TIER_SILVER
           params { key: "step" value: "synthesize" }
           rationale: "ambient + publishing compacted through Engine/Complete when over the 90% target" }
    horizon { window_seconds: 1800 resolve_within_phase_only: true }
  }
  phases {
    id: "synthesize" order: 3
    steps: "synthesize" steps: "end"
    gate { name: "episode_persisted" kind: GATE_KIND_FOOTPRINT_ADVANCED tier: TIER_SILVER
           params { key: "sql" value: "SELECT count(*) FROM cognition_buffer WHERE kind='synthesis' AND created_at > NOW() - INTERVAL '1 hour'" }
           params { key: "min" value: "1" }
           rationale: "the synthesis row IS the product; slices without a synthesis row are a half-run" }
    horizon { window_seconds: 3600 resolve_within_phase_only: true }
    resources { leaf: "root.internal.inference.light" workload: "embedding" occupancy: 1 floor: 1 priority: 40
                rationale: "MaxSim admission of the three axes needs the shared ColBERT claim for the phase; protected above probes, yields to a prospects run" }
  }
}

# ── Objectives on the final surfaced result ────────────────────────────────────

objectives {
  name: "site_freshness"
  surfaced_result: "the card links a visitor sees on gaius.zndx.org (DB vs KV read-back vs live page)"
  machines: "article_curation"
  cadence_cron: "38 1,7,13,19 * * *"
  gates { name: "db_fresh" kind: GATE_KIND_FRESHNESS_WITHIN tier: TIER_SILVER params { key: "source" value: "collections.cards max(published_at)" } params { key: "within_seconds" value: "86400" } rationale: "cards published within a day" }
  gates { name: "kv_coherent" kind: GATE_KIND_PROBE_PASS tier: TIER_SILVER params { key: "probe" value: "kv published_cards read-back == db id-set" } rationale: "the public KV agrees with the DB" }
  gates { name: "live_coherent" kind: GATE_KIND_PROBE_PASS tier: TIER_SILVER params { key: "probe" value: "live page card ids == kv" } rationale: "what the user sees agrees with KV" }
  horizon { window_seconds: 43200 }
  resolves: "slot % cards are publicly served"

  expectation { category: EXPECTATION_CATEGORY_SLOT horizon_slot: 3 channel: CHANNEL_AGENDA_EVENT rationale: "verified four times daily; a FAIL on what the user receives is an Agenda Event within 2 h" } }
objectives {
  name: "content_currency"
  surfaced_result: "the content dates a visitor reads on newly published cards — the schedule's INTENT: content tracks the present"
  machines: "article_curation"
  cadence_cron: "38 1,7,13,19 * * *"
  gates { name: "published_content_current" kind: GATE_KIND_FRESHNESS_WITHIN tier: TIER_SILVER params { key: "source" value: "newest source_date among last-24h publishes" } params { key: "within_seconds" value: "604800" } rationale: "7d: mechanics green while serving 18-day-old content past 25 fresher cards (2026-09-01)" }
  gates { name: "selection_favors_current" kind: GATE_KIND_PROBE_PASS tier: TIER_SILVER params { key: "probe" value: "pending cards with current source_date are selected before older" } rationale: "inconclusive when nothing current is pending — blame inflow" }
  gates { name: "curation_inflow_current" kind: GATE_KIND_FRESHNESS_WITHIN tier: TIER_SILVER params { key: "source" value: "corpus newest source_date" } params { key: "within_seconds" value: "604800" } rationale: "2026-09-03: inflow itself went stale (Aug-27) — the DAG stage named" }
  horizon { window_seconds: 43200 }
  resolves: "slot % serves current content%"

  expectation { category: EXPECTATION_CATEGORY_SLOT horizon_slot: 3 channel: CHANNEL_AGENDA_EVENT rationale: "verified four times daily; a FAIL on what the user receives is an Agenda Event within 2 h" } }
objectives {
  name: "prospects_intelligence"
  surfaced_result: "the prospect briefs the user opens — sufficient to a rebalancing BOUNDARY decision under switching costs, for capital or a professional's scarce time/money/energy (kb current/prospects/portfolio-theory.md)"
  machines: "prospects_update"
  cadence_cron: "38 1,7,13,19 * * *"
  gates { name: "briefs_surfaced" kind: GATE_KIND_FRESHNESS_WITHIN tier: TIER_SILVER params { key: "source" value: "scratch/*/*prospect_*.md mtime" } params { key: "within_seconds" value: "129600" } rationale: "daily promise x 1.5" }
  gates { name: "rubric_wellformed" kind: GATE_KIND_SURFACE_WELLFORMED tier: TIER_SILVER params { key: "glob" value: "scratch/*/*prospect_*.md" } params { key: "min_chars" value: "40" } params { key: "max_symbol_repeats" value: "2" } rationale: "deterministic rubric floor" }
  gates { name: "rubric_sufficiency" kind: GATE_KIND_JUDGE_RUBRIC judge_final_call: true tier: TIER_GOLD
          params { key: "sample_max" value: "3" }
          params { key: "rubric" value: "PRIMARY (required): change|attention|consistency|finish. HETERODOX COMPLEMENT (credit, can tip borderline, never rescues): allocation|framing. See objective_service rubric text." }
          rationale: "Overwatch (ACP+Grok) renders the final call on the artifact the reader sees; local self-score is a forecast resolved gold by that call" }
  horizon { window_seconds: 259200 }
  resolves: "%user receives prospect briefs%"
  expectation { category: EXPECTATION_CATEGORY_JUDGED horizon_slot: 7 channel: CHANNEL_AGENDA_EVENT awaits: "task.prospects_update" rationale: "the judged verdict waits for the next prospects run (13 h to the 07:00 slot rounds down to slot 7); a forward Agenda Event, not a fault" }
}
