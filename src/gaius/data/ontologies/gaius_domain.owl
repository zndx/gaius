        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#Embedding"/>
    </owl:Class>

    <owl:Class rdf:about="http://gaius.zndx.org/ontology#ImageEmbedding">
        <rdfs:label>Image Embedding</rdfs:label>
