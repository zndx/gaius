    <owl:Class rdf:about="http://gaius.zndx.org/ontology#KnowledgeGraph">
        <rdfs:label>Knowledge Graph</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#KnowledgeRepresentation"/>
