    </owl:Class>

    <owl:Class rdf:about="http://gaius.zndx.org/ontology#Embedding">
        <rdfs:label>Embedding</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#VectorRepresentation"/>
