    <owl:Class rdf:about="http://gaius.zndx.org/ontology#ApacheKudu">
        <rdfs:label>Apache Kudu</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#DataProcessing"/>
