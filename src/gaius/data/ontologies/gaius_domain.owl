    <owl:Class rdf:about="http://gaius.zndx.org/ontology#RDF">
        <rdfs:label>Resource Description Framework</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#SemanticWeb"/>
