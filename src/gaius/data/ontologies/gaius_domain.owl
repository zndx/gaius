    <owl:Class rdf:about="http://gaius.zndx.org/ontology#OWL">
        <rdfs:label>Web Ontology Language</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#Ontology"/>
