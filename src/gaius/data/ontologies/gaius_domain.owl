         ==================================== -->

    <owl:Class rdf:about="http://gaius.zndx.org/ontology#Mathematics">
        <rdfs:label>Mathematics</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://gaius.zndx.org/ontology#Topology">
        <rdfs:label>Topology</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#Mathematics"/>
    </owl:Class>

    <owl:Class rdf:about="http://gaius.zndx.org/ontology#AlgebraicTopology">
        <rdfs:label>Algebraic Topology</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#Topology"/>
    </owl:Class>

    <owl:Class rdf:about="http://gaius.zndx.org/ontology#PersistentHomology">
        <rdfs:label>Persistent Homology</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#AlgebraicTopology"/>
    </owl:Class>

    <owl:Class rdf:about="http://gaius.zndx.org/ontology#TopologicalDataAnalysis">
        <rdfs:label>Topological Data Analysis</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#AlgebraicTopology"/>
    </owl:Class>

    <owl:Class rdf:about="http://gaius.zndx.org/ontology#DifferentialGeometry">
        <rdfs:label>Differential Geometry</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#Mathematics"/>
