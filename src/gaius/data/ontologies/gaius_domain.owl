    <owl:Class rdf:about="http://gaius.zndx.org/ontology#SemanticWeb">
        <rdfs:label>Semantic Web</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#KnowledgeRepresentation"/>
