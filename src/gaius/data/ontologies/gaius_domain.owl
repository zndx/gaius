<?xml version="1.0"?>
<!--
Gaius Domain Ontology

An internal ontology for BERTSubsIntraPipeline to provide subsumption inference
for ThetaAgent's cross-temporal linking functionality.

This ontology covers Gaius's core domains:
- Machine Learning / AI concepts
- Knowledge representation / Ontology
- Streaming / Data infrastructure
- Cognitive systems / Agent architectures

Each class has rdfs:label annotations for BERTSubs text semantics.
The hierarchy provides enough subsumption relationships for training.

References:
- BERTSubs: Chen et al. 2023
- DeepOnto: https://github.com/KRR-Oxford/DeepOnto
-->
<rdf:RDF xmlns="http://gaius.zndx.org/ontology#"
     xml:base="http://gaius.zndx.org/ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <owl:Ontology rdf:about="http://gaius.zndx.org/ontology">
        <rdfs:label>Gaius Domain Ontology</rdfs:label>
        <rdfs:comment>Domain ontology for Gaius ThetaAgent subsumption inference</rdfs:comment>
    </owl:Ontology>

    <!-- ====================================
         ARTIFICIAL INTELLIGENCE HIERARCHY
         ==================================== -->

    <!-- Root: AI -->
    <owl:Class rdf:about="http://gaius.zndx.org/ontology#ArtificialIntelligence">
        <rdfs:label>Artificial Intelligence</rdfs:label>
    </owl:Class>

    <!-- Machine Learning branch -->
    <owl:Class rdf:about="http://gaius.zndx.org/ontology#MachineLearning">
        <rdfs:label>Machine Learning</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#ArtificialIntelligence"/>
    </owl:Class>

    <owl:Class rdf:about="http://gaius.zndx.org/ontology#SupervisedLearning">
        <rdfs:label>Supervised Learning</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#MachineLearning"/>
    </owl:Class>

    <owl:Class rdf:about="http://gaius.zndx.org/ontology#UnsupervisedLearning">
        <rdfs:label>Unsupervised Learning</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#MachineLearning"/>
    </owl:Class>

    <owl:Class rdf:about="http://gaius.zndx.org/ontology#ReinforcementLearning">
        <rdfs:label>Reinforcement Learning</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#MachineLearning"/>
    </owl:Class>

    <!-- Deep Learning branch -->
    <owl:Class rdf:about="http://gaius.zndx.org/ontology#DeepLearning">
        <rdfs:label>Deep Learning</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#MachineLearning"/>
    </owl:Class>

    <owl:Class rdf:about="http://gaius.zndx.org/ontology#NeuralNetwork">
        <rdfs:label>Neural Network</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#DeepLearning"/>
    </owl:Class>

    <owl:Class rdf:about="http://gaius.zndx.org/ontology#ConvolutionalNetwork">
        <rdfs:label>Convolutional Neural Network</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#NeuralNetwork"/>
    </owl:Class>

    <owl:Class rdf:about="http://gaius.zndx.org/ontology#RecurrentNetwork">
        <rdfs:label>Recurrent Neural Network</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#NeuralNetwork"/>
    </owl:Class>

    <owl:Class rdf:about="http://gaius.zndx.org/ontology#TransformerNetwork">
        <rdfs:label>Transformer</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#NeuralNetwork"/>
    </owl:Class>

    <owl:Class rdf:about="http://gaius.zndx.org/ontology#Attention">
        <rdfs:label>Attention Mechanism</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#TransformerNetwork"/>
    </owl:Class>

    <owl:Class rdf:about="http://gaius.zndx.org/ontology#LargeLanguageModel">
        <rdfs:label>Large Language Model</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#TransformerNetwork"/>
    </owl:Class>

    <!-- NLP branch -->
    <owl:Class rdf:about="http://gaius.zndx.org/ontology#NaturalLanguageProcessing">
        <rdfs:label>Natural Language Processing</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#ArtificialIntelligence"/>
    </owl:Class>

    <owl:Class rdf:about="http://gaius.zndx.org/ontology#TextClassification">
        <rdfs:label>Text Classification</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#NaturalLanguageProcessing"/>
    </owl:Class>

    <owl:Class rdf:about="http://gaius.zndx.org/ontology#NamedEntityRecognition">
        <rdfs:label>Named Entity Recognition</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#NaturalLanguageProcessing"/>
    </owl:Class>

    <owl:Class rdf:about="http://gaius.zndx.org/ontology#SemanticSearch">
        <rdfs:label>Semantic Search</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://gaius.zndx.org/ontology#NaturalLanguageProcessing"/>
    </owl:Class>

    <!-- ====================================
         KNOWLEDGE REPRESENTATION HIERARCHY
         ==================================== -->

    <owl:Class rdf:about="http://gaius.zndx.org/ontology#KnowledgeRepresentation">
